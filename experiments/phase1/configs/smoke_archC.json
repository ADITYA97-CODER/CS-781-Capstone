{
 "name": "smoke_archC",
 "model": {
  "arch": "C",
  "vocab_size": 32000,
  "d_model": 768,
  "n_layers": 20,
  "n_heads": 12,
  "ffn_hidden": 2048,
  "max_seq_len": 1536
 },
 "data": {
  "tokenizer": "legal_bpe_32k",
  "seq_len": 1536,
  "mix": {
   "supreme_court": 0.2,
   "high_courts": 0.42,
   "tribunals": 0.3,
   "acts": 0.08
  }
 },
 "train": {
  "total_tokens": 20000000,
  "batch_tokens": 24576,
  "micro_batch": 8,
  "lr": 0.0006,
  "min_lr_frac": 0.0,
  "warmup_steps": 5,
  "decay_frac": 0.2,
  "weight_decay": 0.1,
  "beta2": 0.95,
  "grad_clip": 1.0,
  "eval_every": 1000,
  "save_every": 100000,
  "val_windows": 8,
  "log_every": 10,
  "compile": false,
  "seed": 0,
  "mlm_prob": 0.5,
  "mlm_mask_rate": 0.3
 }
}